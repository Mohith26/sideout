{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "npm run demo:reset -- --url \"$SIDEOUT_URL\"",
    "cronSchedule": "0 10 * * *",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
