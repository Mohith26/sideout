# Sideout runtime configuration. Copy to .env.local. The app boots and is fully
# demoable with only LUCRA_MODE=mock set; everything else is optional until phase 4.

# mock | sandbox | production   (default: mock)
LUCRA_MODE=mock

# Lucra REST base URL. Required when LUCRA_MODE is sandbox or production.
# LUCRA_BASE_URL=https://api.sandbox.lucrasports.com

# BACKEND key: server only, sent as X-Lucra-Api-Key. Never prefixed NEXT_PUBLIC_.
# LUCRA_BACKEND_API_KEY=

# WEB key + tenant id: the only Lucra credentials allowed to reach the browser.
# NEXT_PUBLIC_LUCRA_WEB_API_KEY=
# NEXT_PUBLIC_LUCRA_TENANT_ID=

# Shared secret for verifying Lucra webhook signatures (phase 4).
# LUCRA_WEBHOOK_SECRET=

# Real-money head-to-head stays off. Do not enable. (default: false)
FEATURE_REAL_MONEY=false

# SQLite file. Created by `npm run seed`. (default: ./data/sideout.db)
DATABASE_PATH=./data/sideout.db

# Optional: build provenance reported by /health. Falls back to git HEAD, then "unknown".
# BUILD_SHA=
