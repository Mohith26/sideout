# Sideout runtime configuration. Copy to .env.local. The app boots and is fully
# demoable with only LUCRA_MODE=mock set; the Lucra credentials are needed only for
# sandbox/production.

# mock | sandbox | production   (default: mock)
LUCRA_MODE=mock

# Lucra REST base URL. Required when LUCRA_MODE is sandbox or production.
# LUCRA_BASE_URL=https://api.sandbox.lucrasports.com

# BACKEND key: server only, sent as X-Lucra-Api-Key. Never prefixed NEXT_PUBLIC_.
# LUCRA_BACKEND_API_KEY=

# WEB key + tenant id: the only Lucra credentials allowed to reach the browser.
# NEXT_PUBLIC_LUCRA_WEB_API_KEY=
# NEXT_PUBLIC_LUCRA_TENANT_ID=

# Shared secret for verifying Lucra webhook signatures (X-Lucra-Signature, HMAC-SHA256
# over the raw body; issued by your Lucra representative per webhook configuration).
# Required outside mock mode, and in production in every mode: without it
# POST /api/webhooks/lucra answers 401 to every delivery and warns at boot. In mock mode
# outside production a random per-process secret stands in, shared by the in-process
# mock signer and the receiver. Never prefixed NEXT_PUBLIC_.
# LUCRA_WEBHOOK_SECRET=

# Which reading of Lucra's documented metadata matcher the mock runs (src/lucra/matcher.ts):
# `literal` follows the published prose, `doc-examples` the published worked examples
# where the two disagree. Reported by /health. Sideout itself only ever targets by
# externalId, which both readings resolve identically. (default: literal)
# LUCRA_MATCHER_INTERPRETATION=literal

# Real-money head-to-head stays off. Do not enable. (default: false)
FEATURE_REAL_MONEY=false

# SQLite file. Created by `npm run seed`. (default: ./data/sideout.db)
DATABASE_PATH=./data/sideout.db

# Optional: build provenance reported by /health. Falls back to git HEAD, then "unknown".
# BUILD_SHA=

# Signs the session cookie (HMAC-SHA256). At least 16 characters. Outside production a
# fixed dev secret is used when unset; in production an unset value means a random
# per-process secret, a loud warning at boot, and sessions that die on restart.
# SESSION_SECRET=

# Compiles POST /api/dev/login (sign in as a seeded user) into a PRODUCTION build.
# Only for test targets such as the Playwright run, which sets it itself. Never set
# this on a public deployment. Outside production the route always exists.
# (default: false)
# SIDEOUT_DEV_LOGIN=false

# How many trusted reverse proxies sit in front of the server. The sign-in rate
# limit reads the client address from x-forwarded-for that many hops from the
# right; at 0 the header is ignored and only the per-phone and process-wide limits
# apply (production warns at boot). A public deploy behind a proxy — any PaaS, a
# load balancer, nginx — must set 1 (or the depth of its chain). (default: 0)
# TRUSTED_PROXY_HOPS=1

# Process-wide cap on sign-in codes issued per ten minutes: the backstop when no
# client address can be trusted. Raise it for an event whose crowd signs in at
# once. (default: 2000)
# AUTH_CODE_GLOBAL_CAP=2000

# Lucra's responsible gaming policy, linked from the profile and wherever a
# wallet or reward is shown. Override if Lucra names a tenant-specific page.
# (default: https://lucrasports.com/pages/responsible-gaming.html)
# LUCRA_RESPONSIBLE_GAMING_URL=https://lucrasports.com/pages/responsible-gaming.html
